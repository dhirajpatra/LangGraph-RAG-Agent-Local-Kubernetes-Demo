# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values.
# .env is read by setup.sh, which:
#   1) builds the Secret "rag-secrets"  from the *_API_KEY values below
#   2) builds the ConfigMap "rag-config" from the non-secret values below
# .env is never committed to git and never baked into the Docker image.
# ---------------------------------------------------------------------------

# ---- External Managed APIs (top-right of the diagram) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- LangSmith Observability & Evaluation ----
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=FinalProject
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Model selection ----
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSION=1536

# ---- Non-secret app config (-> ConfigMap rag-config) ----
DATABASE_URL=postgresql://raguser:ragpass@postgres-service:5432/ragdb
REDIS_URL=redis://redis-service:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq-service:5672//
CELERY_RESULT_BACKEND=redis://redis-service:6379/1
VECTOR_SEARCH_LIMIT=5
RERANK_TOP_N=3
SEMANTIC_CACHE_THRESHOLD=0.92

# ---- Postgres credentials (used by k8s/postgres.yaml + DATABASE_URL above) ----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# ---- Frontend ----
BACKEND_URL=http://rag-backend-service:8000
